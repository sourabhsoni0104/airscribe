// Reference values for Xcode/CI overrides. Scripts/build-release.sh reads
// DEVELOPMENT_TEAM and AIRSCRIBE_CODE_SIGN_IDENTITY from the environment.
// Never commit certificates, private keys, or notarization credentials.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_IDENTITY = Developer ID Application
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
